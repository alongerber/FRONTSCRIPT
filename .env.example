# ==========================================================
#  פרונט סטודיו — קובץ הגדרות
#  העתק את הקובץ הזה ל-.env ומלא את הערכים.
#  לעולם אל תעלה את .env ל-Git.
# ==========================================================

# --- כניסה לאתר -------------------------------------------
# הסיסמה שתקליד במסך הנעילה. בחר משהו ארוך.
STUDIO_PASSWORD=change-me-please
# מחרוזת אקראית לחתימת העוגייה. צור אחת עם:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-too

# --- מנוע התסריט (Anthropic) -------------------------------
# https://console.anthropic.com
ANTHROPIC_API_KEY=
SCRIPT_MODEL=claude-opus-5

# --- קול (ElevenLabs) --------------------------------------
# https://elevenlabs.io  ->  Profile -> API Key
ELEVENLABS_API_KEY=

# --- אווטאר (HeyGen) ---------------------------------------
# https://app.heygen.com  ->  Settings -> API
HEYGEN_API_KEY=

# --- יצירת B-roll (fal.ai) ---------------------------------
# https://fal.ai/dashboard/keys
# מפתח אחד = גישה ל-Veo, Kling, Wan, FLUX וכל השאר.
FAL_KEY=

# --- אופציונלי --------------------------------------------
# תיקיית המדיה. בענן, הצבע לדיסק הקבוע (למשל /var/data).
MEDIA_ROOT=./media
# נתיב ל-ffmpeg אם הוא לא ב-PATH
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
